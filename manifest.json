{
  "manifest_version": 3,
  "name": "Hello Interview — Wider Reading",
  "version": "3.0.0",
  "description": "Widens Hello Interview lessons and adds keyboard shortcuts for narration playback and speed.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hello Interview reading width",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hellointerview.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
